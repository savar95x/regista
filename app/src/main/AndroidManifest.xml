<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fixtures, crests, club ratings and Google Fonts. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-time reminders (the user grants this from the app on Android 14+). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the "Battery" fix open the one-tap unrestricted prompt (OxygenOS holds alarms back otherwise). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app updates from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".RegistaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_whistle"
        android:roundIcon="@mipmap/ic_launcher_whistle"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Regista"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries, one per app icon (Settings → Look → App icon). Exactly one is enabled; see AppIcons.kt. -->
        <activity-alias
            android:name=".IconWhistle"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_whistle"
            android:roundIcon="@mipmap/ic_launcher_whistle"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconHooked"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_hooked"
            android:roundIcon="@mipmap/ic_launcher_hooked"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSeamsDot"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_seams_dot"
            android:roundIcon="@mipmap/ic_launcher_seams_dot"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSeams"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_seams"
            android:roundIcon="@mipmap/ic_launcher_seams"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPinwheel"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pinwheel"
            android:roundIcon="@mipmap/ic_launcher_pinwheel"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFlag"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_flag"
            android:roundIcon="@mipmap/ic_launcher_flag"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
