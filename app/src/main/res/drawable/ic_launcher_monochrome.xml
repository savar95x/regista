<?xml version="1.0" encoding="utf-8"?>
<!-- Regista's mark: a corner flag (pole and ground line, coral pennant). Same family as Aria and Minutia:
     #1C1C1E background, cream rounded line, one coral accent. Source: docs/icon/regista.svg -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Mark scaled down from the centre for padding: OxygenOS shows only the middle of the icon, so marks look oversized. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.63"
        android:scaleY="0.63">
        <path
            android:pathData="M41,76 L41,32 M41,76 L67,76"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M45.5,33 L66,40.5 L45.5,48 Z"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />
    </group>
</vector>
